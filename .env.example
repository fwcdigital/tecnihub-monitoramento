# ==============================================================================
# TECNIHUB MONITORAMENTO - VARIÁVEIS DE AMBIENTE
# ==============================================================================

# Supabase Project URL (somente backend)
# Exemplo: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Service Role Key (obrigatória no backend; nunca use prefixo VITE_)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Supabase anon key usada SOMENTE pelo backend para validar e-mail/senha no Auth.
# Não criar VITE_SUPABASE_ANON_KEY nesta aplicação administrativa.
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Segredo aleatório com no mínimo 32 bytes para assinar cookies de sessão.
# Gere separadamente em cada ambiente e nunca envie ao Git.
ADMIN_SESSION_SECRET="change-me"

# Chave EXCLUSIVA do cofre: exatamente 32 bytes em base64url, base64 ou hex.
# Gere uma por ambiente, somente no backend. Nunca use VITE_, Git, Supabase ou o
# mesmo valor de ADMIN_SESSION_SECRET. Perder esta chave torna o cofre irrecuperável.
CREDENTIALS_ENCRYPTION_KEY="generate-and-store-a-32-byte-key-securely"

# Hash scrypt da senha mestre. Gere manualmente com `npm run vault:setup`.
# Não configure a senha mestre em plaintext.
CREDENTIALS_MASTER_PASSWORD_HASH="scrypt-v1-generated-by-vault-setup"

# Segredo exclusivo do cron de monitoramento (mínimo 32 bytes aleatórios).
# Configure somente no backend e envie no header Authorization: Bearer <segredo>
# ao chamar POST /api/internal/monitor/run. Nunca use prefixo VITE_ ou exponha no frontend.
MONITOR_CRON_SECRET="change-me-with-a-different-random-secret"

# Segredo exclusivo do cron de entregas (mínimo 32 bytes aleatórios). Use um
# valor diferente de MONITOR_CRON_SECRET no POST /api/internal/alerts/run.
ALERT_CRON_SECRET="change-me-with-an-alerts-only-random-secret"

# Sessão administrativa: padrão de 8 horas; limites aceitos: 300 a 86400.
ADMIN_SESSION_TTL_SECONDS=28800

# Porta do Servidor Backend de Monitoramento
PORT=3001

# Na Hostinger, use production para habilitar o atributo Secure no cookie.
NODE_ENV=production

# Origens adicionais permitidas, separadas por vírgula. Em produção, configure
# o domínio real da aplicação. Requisições same-origin não dependem de CORS.
ALLOWED_ORIGINS="https://monitoramento.seudominio.com.br"

# Cada chamada do cron processa somente um lote persistido. Valores maiores são
# limitados pelo backend para proteger CPU, rede e o timeout externo de 30 segundos.
MONITOR_CRON_BATCH_SIZE=5
MONITOR_CRON_CONCURRENCY=5

# Provedor transacional de e-mail. A chave real deve existir somente nas
# variáveis do backend da Hostinger e nunca no Git, frontend ou Supabase.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="TECNIHUB Monitoramento <alertas@alerts.tecnihub.com.br>"
EMAIL_REPLY_TO=
MONITOR_PUBLIC_URL="https://monitoramento.tecnihub.com.br"
EMAIL_REQUEST_TIMEOUT_MS=6000
EMAIL_DELIVERY_BATCH_SIZE=5
EMAIL_DELIVERY_CONCURRENCY=2

# O agendamento é externo: configure o cron-job.org para chamar o endpoint
# interno protegido. O Express não usa setInterval como scheduler principal.

# Use 1 somente quando a aplicação estiver atrás de exatamente um proxy confiável
# (como o proxy reverso da hospedagem). Caso contrário, mantenha 0.
TRUST_PROXY=0
