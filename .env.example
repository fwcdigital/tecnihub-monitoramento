# Supabase Project URL (obtido em: Supabase Dashboard > Project Settings > API > Project URL)
# Exemplo: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon Key (obtido em: Supabase Dashboard > Project Settings > API > Project API Keys > anon / public)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (opcional, para operações privilegiadas de backend se necessário)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Porta do Servidor Backend de Monitoramento
PORT=3001
